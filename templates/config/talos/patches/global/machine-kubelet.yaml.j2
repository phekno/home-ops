machine:
  kubelet:
    extraConfig:
      serializeImagePulls: false
      # Image garbage collection. Left at the kubelet defaults, images are
      # reclaimed only under disk pressure (85%) and never because they are
      # stale, so old layers accumulate indefinitely. imageMaximumGCAge prunes
      # images unused for longer than the duration regardless of disk usage,
      # and the thresholds are lowered so collection happens below the 75% mark
      # the NodeDiskPressureWarning rule alerts on.
      imageMaximumGCAge: 168h
      imageGCHighThresholdPercent: 75
      imageGCLowThresholdPercent: 65
    nodeIP:
      validSubnets:
        - #{ node_cidr }#
